{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "QuoteFlow desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/quoteflow-api",
          "sidecar": true,
          "args": true,
          "env": true
        }
      ]
    }
  ]
}
