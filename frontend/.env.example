# Copy to .env.local for local web development (npm run dev)

# Backend API (required for estimates)
VITE_API_BASE=http://127.0.0.1:8000/api

# Optional: direct Windows installer (.exe) from a GitHub Release
# After: git tag v0.1.0 && git push origin v0.1.0 → Actions builds → copy .exe link from Releases
# VITE_DOWNLOAD_URL=https://github.com/Mavros-Lykos/QuoteFlow/releases/download/v0.1.0/QuoteFlow_0.1.0_x64-setup.exe
#
# Optional: Releases page if VITE_DOWNLOAD_URL is empty (site falls back to this)
# VITE_RELEASES_URL=https://github.com/Mavros-Lykos/QuoteFlow/releases/latest
