# QuoteFlow FastAPI backend (tools call this)
QUOTEFLOW_API_BASE=http://127.0.0.1:8000/api

# Mastra agent model (router format). Tools do the open-weight Gemma work via FastAPI.
# Examples: openai/gpt-4o-mini | google/gemini-2.5-flash
MASTRA_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
