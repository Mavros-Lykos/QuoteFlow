# QuoteFlow AI Configuration
# All keys OPTIONAL. Without them: local Ollama (if running) → honest offline-heuristic fallback.

# Model Runtime
DEFAULT_MODEL_PROVIDER=ollama   # ollama | groq | mock (mock = explicit rule-based estimator, never labeled as Gemma)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b          # Recommended balance for contractor laptops. Alts: gemma3:1b, gemma2:9b, qwen2.5:7b

# Cloud open-weight fallback (free tier: console.groq.com) — used for Render demos
GROQ_API_KEY=

# Partner Integrations (Optional)
SERPAPI_API_KEY=                # Live contractor labor benchmarks (parsed when possible)
PRIORLABS_TABPFN_API_KEY=       # TabPFN 3.5 pricing — applied to quote totals
ELEVENLABS_API_KEY=             # Voice STT + proposal TTS
# Tiger Data G3 (Best Use of Tiger Data) — free Tiger Cloud trial connection string
# postgres://tsdbadmin:...@....tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
TIGER_DATA_CONNECTION_STRING=
EMBEDDING_MODE=local            # local (free) | openai (needs OPENAI_API_KEY)
# OPENAI_API_KEY=               # only if EMBEDDING_MODE=openai

SENTRY_DSN=                     # Agent step tracing (optional free tier)

# Follow-ups: local SQLite scheduler only (Temporal prize deferred — free-tier focus)
FOLLOWUP_CHECKIN_SECONDS=259200
FOLLOWUP_EXPIRY_SECONDS=604800
